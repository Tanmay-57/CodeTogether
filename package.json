{
  "name": "codetogether",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm run -r --parallel dev",
    "build": "pnpm run -r build",
    "typecheck": "pnpm run -r typecheck",
    "test": "pnpm run -r test",
    "e2e": "pnpm --filter @codetogether/web e2e"
  }
}
