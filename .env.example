# Server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info
ROOM_TTL_MS=14400000
ROOM_HARD_CAP_MS=43200000
EMPTY_ROOM_GRACE_MS=120000
RECONNECT_GRACE_MS=20000
MAX_PARTICIPANTS=4
MAX_DOC_BYTES=524288
MAX_SIGNAL_BYTES=65536
CREATE_ROOM_PER_MINUTE=10
SIGNALS_PER_SECOND=30
RUN_TIMEOUT_MS=10000
MAX_RUN_OUTPUT_BYTES=65536
RUNS_PER_MINUTE=6
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Web build. Do not put TURN secrets here.
VITE_SERVER_URL=http://127.0.0.1:3001
VITE_YJS_URL=ws://127.0.0.1:3001/yjs
